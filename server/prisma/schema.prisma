// Prisma schema for YatraGuard
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                    String               @id @default(uuid())
  email                 String               @unique
  passwordHash          String?
  googleId              String?              @unique
  avatarUrl             String?
  name                  String
  phone                 String?
  location              String?
  aboutMe               String?
  travelPreferences     String?              // e.g. "Mountains, Heritage, Budget, Solo"
  emergencyContactName  String?
  emergencyContactPhone String?
  isActive              Boolean              @default(true)
  role                  String               @default("TRAVELER") // TRAVELER, MODERATOR, ADMIN
  authProvider          String               @default("LOCAL")    // LOCAL, GOOGLE
  isEmailVerified       Boolean              @default(false)
  resetToken            String?
  resetTokenExpiry      DateTime?
  reputationScore       Int                  @default(100)
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  trips                 Trip[]
  tripExpenses          TripExpense[]
  incidents             IncidentReport[]
  incidentVerifications IncidentVerification[]
  incidentFlags         IncidentFlag[]
  priceSubmissions      PriceRecord[]
  notificationPrefs     NotificationPreference?
  aiConversations       AIConversation[]
  vaultItems            VaultItem[]
  vaultDocuments        DocumentRecord[]
  lostFoundItems        LostFoundItem[]
  lostFoundInquiries    LostFoundInquiry[]
  serviceReviews        ServiceReview[]
  roadCrowdReports      RoadCrowdReport[]
  travelGroupsCreated   TravelGroup[]        @relation("CreatedTravelGroups")
  groupMemberships      TravelGroupMember[]
  groupMessages         TravelGroupMessage[]
  blockedUsers          UserSafetyBlock[]    @relation("BlockerUser")
  blockedByUsers        UserSafetyBlock[]    @relation("BlockedTarget")
  emergencyLogs         EmergencyLog[]
  emergencyContacts     EmergencyContact[]
  riskAlertsCreated     TravelRiskAlert[]    @relation("CreatedRiskAlerts")
  fareReports           FareReport[]
  communityPosts        CommunityPost[]
  comments              PostComment[]
  buddyRequestsSent     TravelBuddyRequest[] @relation("SentBuddyRequests")
  connectionsSent       BuddyConnection[]    @relation("ConnectionsSent")
  connectionsReceived   BuddyConnection[]    @relation("ConnectionsReceived")
  buddyMessages         BuddyMessage[]       @relation("MessagesSent")
  notifications         Notification[]
  savedDestinations     SavedDestination[]
  adminAuditLogs        AdminAuditLog[]
  moderationActions     ModerationAction[]
  profileImage          ProfileImage?
  postMedia             PostMedia[]
  savedPlaces           SavedPlace[]
  savedRoutes           SavedRoute[]
}

model City {
  id                 String            @id @default(uuid())
  name               String            @unique
  state              String
  lat                Float
  lng                Float
  defaultSafetyScore Int               @default(75)
  tier               String            @default("TIER_1") // TIER_1, TIER_2, TOURIST_HUB
  description        String?
  services           LocationService[]
  incidents          IncidentReport[]
  scams              ScamReport[]
  safetyZones        SafetyZone[]
  travelCosts        TravelCost[]
  crowdLevels        CrowdLevel[]
  weatherAlerts      WeatherAlert[]
  riskAlerts         TravelRiskAlert[]
  lostFoundItems     LostFoundItem[]
  roadCrowdReports   RoadCrowdReport[]
  fareRules          CityFareRule[]
  fareReports        FareReport[]
  priceRecords       PriceRecord[]
  createdAt          DateTime          @default(now())
}

model TransportationMode {
  id          String         @id // "AUTO", "E_RICKSHAW", "LOCAL_TAXI", "PRIVATE_CAB", "SHARED_TAXI", "LOCAL_BUS", "GOVT_BUS", "METRO", "BIKE_TAXI"
  displayName String         // e.g. "Auto Rickshaw"
  description String?        // e.g. "Metered 3-wheeler autorickshaw"
  vehicleType String         // e.g. "3-Wheeler", "Cab", "Bus", "Rail", "2-Wheeler"
  isMetered   Boolean        @default(true)
  fareRules   CityFareRule[]
  fareReports FareReport[]
}

model CityFareRule {
  id                      String             @id @default(uuid())
  cityId                  String
  city                    City               @relation(fields: [cityId], references: [id], onDelete: Cascade)
  transportModeId         String
  transportMode           TransportationMode @relation(fields: [transportModeId], references: [id], onDelete: Cascade)
  baseFare                Float              // Base flag-drop fare in ₹
  baseDistanceKm          Float              // Distance covered by base fare (e.g. 1.5 km or 2.0 km)
  perKmRate               Float              // Rate per km after base distance
  waitingChargePerHour    Float              @default(30.0) // Waiting charge per hr
  nightSurchargePct       Float              @default(25.0) // Night surcharge e.g. 25% (23:00 - 05:00)
  luggageCharge           Float              @default(10.0) // Flat luggage rate per heavy bag
  hillTerrainSurchargePct Float              @default(0.0)  // Hill terrain adjustment (e.g. 25% in Manali)
  sourceType              String             @default("OFFICIAL_GOVT") // OFFICIAL_GOVT, UNION_NOTIFIED, ESTIMATED, COMMUNITY_BENCHMARK
  officialCircularRef     String?            // Reference circular e.g. "Delhi Transport Dept 2023 / MMRTA 2024"
  reliabilityScore        Int                @default(90) // 1-100%
  notes                   String?
  lastVerifiedDate        DateTime           @default(now())
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt
}

model FareReport {
  id                 String             @id @default(uuid())
  cityId             String
  city               City               @relation(fields: [cityId], references: [id], onDelete: Cascade)
  transportModeId    String
  transportMode      TransportationMode @relation(fields: [transportModeId], references: [id], onDelete: Cascade)
  userId             String?
  user               User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  originName         String             // e.g. "Haridwar Railway Station" or "Mall Road"
  destinationName    String             // e.g. "Rishikesh Laxman Jhula" or "Solang Valley"
  distanceKm         Float              // e.g. 28.5 or 13.2
  actualFarePaid     Float              // Fare paid in ₹
  quotedFare         Float?             // Initial fare quoted by driver
  wasOvercharged     Boolean            @default(false)
  verificationStatus String             @default("COMMUNITY_VERIFIED") // PENDING, COMMUNITY_VERIFIED, REJECTED
  reliabilityWeight  Int                @default(80)
  comments           String?
  tripTime           DateTime           @default(now())
  createdAt          DateTime           @default(now())
}

model LocationService {
  id                 String          @id @default(uuid())
  name               String
  category           String          // HOSPITAL, POLICE, PHARMACY, TRANSPORT, ATM, FUEL, HOTEL, RESTAURANT, TOURIST_INFO, SHOPPING, MECHANIC, GUIDE
  subCategory        String?         // TRAUMA_CENTER, CLINIC, LAB, BLOOD_BANK, AMBULANCE, PETROL_PUMP, AUTO_REPAIR, TOUR_GUIDE, TAXI_COUNTER, etc.
  lat                Float
  lng                Float
  address            String
  phone              String?
  rating             Float?          @default(4.2)
  openStatus         String          @default("Open 24/7")
  openingHours       String?
  website            String?
  isVerified         Boolean         @default(true)
  verificationSource String?         // e.g. "Admin Verified Registry", "Ministry Directory"
  cityId             String
  city               City            @relation(fields: [cityId], references: [id], onDelete: Cascade)
  reviews            ServiceReview[]
  createdAt          DateTime        @default(now())
}

model ServiceReview {
  id        String          @id @default(uuid())
  serviceId String
  service   LocationService @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating    Int             // 1..5
  comment   String
  createdAt DateTime        @default(now())

  @@unique([serviceId, userId])
  @@index([serviceId])
}

model IncidentReport {
  id                 String                 @id @default(uuid())
  category           String                 // taxi_overcharging, auto_overcharging, fake_tour_operator, hotel_scam, fake_guide, shopping_scam, online_fraud, theft, harassment, unsafe_location, suspicious_activity, other
  title              String
  description        String
  lat                Float
  lng                Float
  address            String
  cityId             String
  city               City                   @relation(fields: [cityId], references: [id], onDelete: Cascade)
  status             String                 @default("PENDING") // PENDING, UNDER_REVIEW, VERIFIED, REJECTED, RESOLVED, EXPIRED
  confidenceScore    Int                    @default(45) // 0-100%
  confirmations      Int                    @default(1)
  confirmationsCount Int                    @default(0)
  outdatedCount      Int                    @default(0)
  flagsCount         Int                    @default(0)
  amountDemanded     Float?
  amountPaid         Float?
  evidenceUrl        String?
  scamFlagSignal     String?                // LOW_SIGNAL, PATTERN_MATCH, HIGH_ALERT_SIGNAL (Advisory only)
  scamAdvisoryNote   String?                // Explainable heuristic note for moderator triage
  incidentDate       DateTime               @default(now())
  reportedAt         DateTime               @default(now())
  reporterId         String?
  reporter           User?                  @relation(fields: [reporterId], references: [id], onDelete: SetNull)
  verifications      IncidentVerification[]
  flags              IncidentFlag[]
}

model IncidentVerification {
  id         String         @id @default(uuid())
  incidentId String
  incident   IncidentReport @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  userId     String
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       String         // CONFIRM_RELEVANT, MARK_OUTDATED, ADD_EVIDENCE
  notes      String?
  createdAt  DateTime       @default(now())

  @@unique([incidentId, userId, type])
}

model IncidentFlag {
  id         String         @id @default(uuid())
  incidentId String
  incident   IncidentReport @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  userId     String
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  reason     String         // INACCURATE, SPAM, ABUSIVE, FALSE_REPORT
  details    String?
  createdAt  DateTime       @default(now())
}

model PriceRecord {
  id                 String   @id @default(uuid())
  cityId             String
  city               City     @relation(fields: [cityId], references: [id], onDelete: Cascade)
  category           String   // FOOD_DINING, STREET_FOOD, HOTEL_RESORT, HOSTEL, HOMESTAY, ATTRACTION_ENTRY, ADVENTURE_ACTIVITY, LOCAL_SHOPPING, PARKING, LOCAL_TRANSPORT, SERVICES
  itemName           String   // e.g., "Full Thali Meal", "White Water Rafting (16km)", "Standard Scooter Rental"
  minPrice           Float
  maxPrice           Float
  currency           String   @default("INR (₹)")
  sourceType         String   @default("OFFICIAL_BENCHMARK") // OFFICIAL_BENCHMARK, VERIFIED_PROVIDER, COMMUNITY_SUBMISSION, GOVT_TARIFF
  sourceReference    String?  // Reference note / authority
  verificationStatus String   @default("VERIFIED") // VERIFIED, PENDING, REJECTED
  submittedById      String?
  submittedBy        User?    @relation(fields: [submittedById], references: [id], onDelete: SetNull)
  notes              String?
  lastUpdated        DateTime @default(now())
  createdAt          DateTime @default(now())
}

model RoutePriceQuery {
  id             String   @id @default(uuid())
  cityId         String?
  fromName       String
  toName         String
  fromLat        Float?
  fromLng        Float?
  toLat          Float?
  toLng          Float?
  transportType  String   // WALKING, BUS, METRO, AUTO, E_RICKSHAW, TAXI, SHARED_TAXI, BIKE_TAXI, RENTAL
  distanceKm     Float
  durationMins   Int
  estimatedPrice Float
  minPrice       Float
  maxPrice       Float
  createdAt      DateTime @default(now())
}

model NotificationPreference {
  id               String   @id @default(uuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  nearbyAlerts     Boolean  @default(true)
  fareAudits       Boolean  @default(true)
  communityUpdates Boolean  @default(true)
  radiusKm         Float    @default(5.0)
  updatedAt        DateTime @default(now())
}

model ScamReport {
  id             String   @id @default(uuid())
  category       String   // taxi_scam, fake_guide, fake_tickets, overcharging, fake_hotel, shopping_scam, atm_payment, religious_tourism, transport
  title          String
  locationName   String
  lat            Float
  lng            Float
  address        String
  cityId         String
  city           City     @relation(fields: [cityId], references: [id], onDelete: Cascade)
  description    String
  warningSigns   String
  typicalPattern String
  reportCount    Int      @default(3)
  confidence     Int      @default(80) // %
  lastReportedAt DateTime @default(now())
  createdAt      DateTime @default(now())
}

model SafetyZone {
  id          String   @id @default(uuid())
  name        String
  cityId      String
  city        City     @relation(fields: [cityId], references: [id], onDelete: Cascade)
  lat         Float
  lng         Float
  radiusKm    Float    @default(1.0)
  riskTier    String   @default("ACCEPTABLE") // HIGH_RISK, MODERATE, ACCEPTABLE, GOOD, VERY_GOOD
  score       Int      @default(65)
  reason      String
  timeHazard  String?  // e.g. "Higher risk after 10 PM"
  createdAt   DateTime @default(now())
}

model TravelCost {
  id                  String   @id @default(uuid())
  cityId              String
  city                City     @relation(fields: [cityId], references: [id], onDelete: Cascade)
  category            String   // TAXI, AUTO, METRO, BUS, FOOD, HOTEL, ATTRACTION
  name                String   // e.g., "Prepaid Auto (Per 5km)"
  estimatedMin        Int
  estimatedMax        Int
  localReportedMin    Int
  localReportedMax    Int
  unit                String   @default("INR (₹)")
  notes               String?
  isOverchargingProne Boolean  @default(false)
  createdAt           DateTime @default(now())
}

model CrowdLevel {
  id                 String   @id @default(uuid())
  cityId             String
  city               City     @relation(fields: [cityId], references: [id], onDelete: Cascade)
  attractionName     String
  currentLevel       String   @default("MEDIUM") // LOW, MEDIUM, HIGH, VERY_HIGH
  bestVisitingHours  String   // e.g. "4:00 PM – 6:00 PM"
  peakHours          String   // e.g. "11:00 AM – 3:00 PM"
  crowdEstimateLabel String   // e.g. "Moderate queue at east gate"
  updatedAt          DateTime @default(now())
}

model WeatherAlert {
  id           String   @id @default(uuid())
  cityId       String
  city         City     @relation(fields: [cityId], references: [id], onDelete: Cascade)
  temp         Float    @default(29.0)
  condition    String   @default("Partly Cloudy")
  rainChance   Int      @default(10) // %
  humidity     Int      @default(55) // %
  windKmh      Float    @default(12.0)
  alertMessage String?  // e.g., "Heat Advisory: Carry hydration"
  severity     String?  // LOW, MODERATE, HIGH
  sourceName   String?  // e.g., "Open-Meteo Forecast", "Cached Advisory"
  forecastJson Json?    // Cached 5-day forecast summary
  updatedAt    DateTime @default(now())
}

model Trip {
  id                    String        @id @default(uuid())
  userId                String
  user                  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  title                 String
  originCity            String?
  destinationCity       String
  currentLocation       String?
  startDate             String
  endDate               String
  travelersCount        Int           @default(1)
  totalBudget           Float?
  transportPref         String?       // AUTO_TAXI, PUBLIC_TRANSIT, CAB, BIKE_RENTAL, MIXED
  interests             String?       // Comma-separated interests
  itineraryData         Json?         // Structured editable day-wise itinerary
  emergencyContactName  String
  emergencyContactPhone String
  status                String        @default("ACTIVE") // ACTIVE, COMPLETED
  shareToken            String        @unique @default(uuid())
  lastKnownEta          String?
  expenses              TripExpense[]
  documents             DocumentRecord[]
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@index([userId])
}

model TripExpense {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tripId      String?
  trip        Trip?    @relation(fields: [tripId], references: [id], onDelete: SetNull)
  title       String
  category    String   // TRANSPORTATION, FOOD, ACCOMMODATION, SHOPPING, ACTIVITIES, EMERGENCY, OTHER
  amount      Float
  currency    String   @default("INR")
  expenseDate String   // YYYY-MM-DD
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, expenseDate])
  @@index([tripId])
}

model VaultItem {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String
  category      String   // INSURANCE, HOTEL_RES, FLIGHT_TRAIN, VISA_REF, EMBASSY_CONTACT, DOCTOR
  referenceData String   // Reference code / sanitized metadata (no raw sensitive docs)
  notes         String?
  createdAt     DateTime @default(now())
}

model DocumentRecord {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tripId           String?
  trip             Trip?    @relation(fields: [tripId], references: [id], onDelete: SetNull)
  title            String
  docType          String   // TICKET, HOTEL, ID_REF, PERMIT, INSURANCE, RESERVATION
  originalFilename String
  storageKey       String   // Filename stored inside private non-public server/private_vault/
  mimeType         String
  fileSize         Int
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([userId])
}

model LostFoundItem {
  id               String             @id @default(uuid())
  userId           String
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  cityId           String?
  city             City?              @relation(fields: [cityId], references: [id], onDelete: SetNull)
  type             String             // LOST, FOUND
  title            String
  category         String             // PHONE, WALLET_ID, LUGGAGE, DOCUMENTS, JEWELRY, KEYS, OTHER
  description      String
  locationName     String
  lat              Float?
  lng              Float?
  eventDate        String             // YYYY-MM-DD
  imageUrl         String?
  status           String             @default("OPEN") // OPEN, MATCHED, RESOLVED
  moderationStatus String             @default("APPROVED") // APPROVED, PENDING, HIDDEN
  inquiries        LostFoundInquiry[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([type, status])
  @@index([cityId])
}

model LostFoundInquiry {
  id          String        @id @default(uuid())
  itemId      String
  item        LostFoundItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  senderId    String
  sender      User          @relation(fields: [senderId], references: [id], onDelete: Cascade)
  message     String
  contactHint String?       // Optional contact note shared privately only with item poster
  createdAt   DateTime      @default(now())

  @@index([itemId])
}

model RoadCrowdReport {
  id           String    @id @default(uuid())
  userId       String?
  user         User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  cityId       String?
  city         City?     @relation(fields: [cityId], references: [id], onDelete: SetNull)
  locationName String
  lat          Float
  lng          Float
  category     String    // ROAD_CONDITION, TRAFFIC, CROWD, ROAD_CLOSURE, CONSTRUCTION, ACCIDENT
  difficulty   String    @default("MODERATE") // EASY, MODERATE, DIFFICULT, BLOCKED
  description  String
  status       String    @default("PENDING") // PENDING, VERIFIED, EXPIRED, REJECTED
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([cityId, expiresAt])
}

model TravelGroup {
  id                String               @id @default(uuid())
  creatorId         String
  creator           User                 @relation("CreatedTravelGroups", fields: [creatorId], references: [id], onDelete: Cascade)
  title             String
  destinationCity   String
  originCity        String?
  startDate         String
  endDate           String
  maxMembers        Int                  @default(6)
  budgetNote        String?
  itineraryNotes    String?
  sharedExpenseNote String?
  status            String               @default("OPEN") // OPEN, ACTIVE, COMPLETED
  members           TravelGroupMember[]
  messages          TravelGroupMessage[]
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
}

model TravelGroupMember {
  id       String      @id @default(uuid())
  groupId  String
  group    TravelGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId   String
  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     String      @default("MEMBER") // CREATOR, MEMBER
  joinedAt DateTime    @default(now())

  @@unique([groupId, userId])
}

model TravelGroupMessage {
  id        String      @id @default(uuid())
  groupId   String
  group     TravelGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User        @relation(fields: [senderId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime    @default(now())

  @@index([groupId])
}

model UserSafetyBlock {
  id            String   @id @default(uuid())
  blockerId     String
  blocker       User     @relation("BlockerUser", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedUserId String
  blockedUser   User     @relation("BlockedTarget", fields: [blockedUserId], references: [id], onDelete: Cascade)
  reason        String?
  createdAt     DateTime @default(now())

  @@unique([blockerId, blockedUserId])
}

model AIConversation {
  id          String   @id @default(uuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userPrompt  String
  aiResponse  String
  cityContext String?
  createdAt   DateTime @default(now())
}

model EmergencyLog {
  id              String   @id @default(uuid())
  userId          String?
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  cityId          String?
  emergencyType   String   // SOS_112, POLICE, MEDICAL, HARASSMENT, LOCATION_SHARE
  lat             Float
  lng             Float
  address         String?
  messageText     String?
  sharedWithCount Int      @default(0)
  status          String   @default("LOGGED")
  createdAt       DateTime @default(now())
}

model EmergencyContact {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name             String
  phone            String
  relation         String   @default("Family")
  isPrimary        Boolean  @default(false)
  canShareLocation Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([userId])
}

model TravelRiskAlert {
  id                 String    @id @default(uuid())
  cityId             String?
  city               City?     @relation(fields: [cityId], references: [id], onDelete: SetNull)
  destinationName    String
  lat                Float?
  lng                Float?
  category           String    // HEAVY_RAINFALL, FLOOD, LANDSLIDE, SNOWFALL, ROAD_CLOSURE, ACCIDENT, OVERCROWDING, UNSAFE_AREA, SCAM_WARNING
  title              String
  description        String
  severity           String    @default("MODERATE") // LOW, MODERATE, HIGH, CRITICAL
  sourceType         String    @default("COMMUNITY") // OFFICIAL, MODERATOR_VERIFIED, COMMUNITY
  sourceName         String?
  verificationStatus String    @default("PENDING") // PENDING, VERIFIED, REJECTED
  expiresAt          DateTime?
  createdById        String?
  createdBy          User?     @relation("CreatedRiskAlerts", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([cityId, expiresAt])
  @@index([severity])
}

model CommunityPost {
  id              String        @id @default(uuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  cityId          String?
  title           String
  content         String
  destinationName String        // e.g. "Manali", "Rishikesh", "Goa"
  category        String        @default("STORY") // STORY, RECOMMENDATION, SAFETY_TIP, BUDGET, HIDDEN_GEM
  likesCount      Int           @default(0)
  imageUrl        String?
  media           PostMedia[]
  comments        PostComment[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model PostComment {
  id        String        @id @default(uuid())
  postId    String
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime      @default(now())
}

model TravelBuddyRequest {
  id                  String              @id @default(uuid())
  senderId            String
  sender              User                @relation("SentBuddyRequests", fields: [senderId], references: [id], onDelete: Cascade)
  destinationCity     String
  fromLocation        String?             // Starting location
  startDate           String
  endDate             String
  travelStyle         String              @default("ADVENTURE") // BACKPACKER, ADVENTURE, CULTURAL, LUXURY, ROAD_TRIP
  budgetTier          String              @default("MODERATE") // BUDGET, MODERATE, LUXURY
  companionsNeeded    Int                 @default(1)
  preferredLanguage   String?
  notes               String?
  status              String              @default("OPEN") // OPEN, MATCHED, CANCELLED
  createdAt           DateTime            @default(now())
  connections         BuddyConnection[]  @relation("RequestConnections")
}

model BuddyConnection {
  id              String                @id @default(uuid())
  requestId       String
  request         TravelBuddyRequest    @relation("RequestConnections", fields: [requestId], references: [id], onDelete: Cascade)
  senderId        String
  senderUser      User                  @relation("ConnectionsSent", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId      String
  receiverUser    User                  @relation("ConnectionsReceived", fields: [receiverId], references: [id], onDelete: Cascade)
  message         String?
  status          String                @default("PENDING") // PENDING, ACCEPTED, REJECTED, CANCELLED
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  messages        BuddyMessage[]
}

model BuddyMessage {
  id            String          @id @default(uuid())
  connectionId  String
  connection    BuddyConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  senderId      String
  senderUser    User            @relation("MessagesSent", fields: [senderId], references: [id], onDelete: Cascade)
  content       String
  isRead        Boolean         @default(false)
  createdAt     DateTime        @default(now())
}

model SavedDestination {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cityName  String
  state     String
  imageUrl  String?
  notes     String?
  createdAt DateTime @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   @default("INFO") // INFO, ALERT, BUDDY, FARE, SOS
  isRead    Boolean  @default(false)
  linkUrl   String?
  createdAt DateTime @default(now())
}

model AdminAuditLog {
  id           String   @id @default(uuid())
  adminId      String
  admin        User     @relation(fields: [adminId], references: [id], onDelete: Cascade)
  action       String   // VERIFY_INCIDENT, UPDATE_FARE, SUSPEND_USER, DELETE_POST, VERIFY_FARE, PROMOTE_MODERATOR, REVOKE_MODERATOR
  targetEntity String   // INCIDENT, FARE, USER, POST
  targetId     String?
  details      String?
  createdAt    DateTime @default(now())
}

model PostMedia {
  id        String        @id @default(uuid())
  postId    String
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  url       String
  publicId  String?
  mimeType  String
  fileSize  Int
  width     Int?
  height    Int?
  altText   String?
  sortOrder Int           @default(0)
  createdAt DateTime      @default(now())
}

model ModerationAction {
  id           String   @id @default(uuid())
  moderatorId  String
  moderator    User     @relation(fields: [moderatorId], references: [id], onDelete: Cascade)
  action       String   // VERIFY, REJECT, REQUEST_INFO, ESCALATE, HIDE_POST, FLAG_CONTENT
  targetEntity String   // INCIDENT, POST, COMMENT, USER
  targetId     String
  reason       String?
  notes        String?
  createdAt    DateTime @default(now())
}

model ProfileImage {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  url       String
  publicId  String?
  mimeType  String
  fileSize  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SavedPlace {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  placeId     String?
  name        String
  category    String
  address     String
  lat         Float
  lng         Float
  phone       String?
  notes       String?
  createdAt   DateTime @default(now())

  @@index([userId])
}

model SavedRoute {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  originName       String
  destName         String
  originLat        Float
  originLng        Float
  destLat          Float
  destLng          Float
  distanceKm       Float
  travelMode       String   @default("DRIVING")
  estimatedMinutes Int
  createdAt        DateTime @default(now())

  @@index([userId])
}


