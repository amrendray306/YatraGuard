PORT=5001
# Local SQLite database URL (Prisma default for zero-setup local running)
# To use PostgreSQL in production, set: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="file:./dev.db"
JWT_SECRET="travel-guardian-secure-jwt-secret-key-2025"

# Optional: Google Gemini API key for live AI Travel Guardian
# If left empty, the application automatically runs in intelligent Demo Mode with contextual safety heuristics
GEMINI_API_KEY=""

# Flag indicating demo dataset mode is enabled
DEMO_MODE=true
