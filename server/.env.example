PORT=5001
NODE_ENV="development"
DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require"
JWT_SECRET="replace-with-strong-256-bit-random-secret"
JWT_EXPIRY="7d"
FRONTEND_URL="http://localhost:3000"
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173,https://your-app.vercel.app"
ALLOW_VERCEL_PREVIEWS="true"
PUBLIC_URL=""

# Password Reset Email Dispatch (Resend)
RESEND_API_KEY=""
EMAIL_FROM="YatraGuard Security <noreply@yourdomain.com>"

# AI Travel Guardian (Google Gemini)
GEMINI_API_KEY=""
DEMO_MODE="false"

# Google OAuth 2.0 (Google Identity Services)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Google Maps Platform (Places API New, Routes API, Geocoding)
GOOGLE_MAPS_API_KEY=""

# Cloudinary (Persistent image uploads in production)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
