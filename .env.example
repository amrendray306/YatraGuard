# ====================================================================
# YATRAGUARD — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ====================================================================
# Copy to server/.env before starting the backend locally:
# cp server/.env.example server/.env

# --------------------------------------------------------------------
# 1. APPLICATION & SERVER RUNTIME
# --------------------------------------------------------------------
NODE_ENV="development" # Set to "production" on Render / cloud hosts
PORT=5001
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173,https://your-app.vercel.app"
ALLOW_VERCEL_PREVIEWS="true"
PUBLIC_URL="" # Optional: override public base URL for local upload links (auto-detected on Render)

# --------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (Neon PostgreSQL)
# --------------------------------------------------------------------
DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require"

# --------------------------------------------------------------------
# 3. CRYPTOGRAPHIC SECURITY & SESSION MANAGEMENT
# --------------------------------------------------------------------
# Generate with: openssl rand -base64 32
JWT_SECRET="replace-with-strong-256-bit-random-secret"
JWT_EXPIRY="7d"

# --------------------------------------------------------------------
# 4. GOOGLE OAUTH 2.0 / OPENID CONNECT CREDENTIALS
# --------------------------------------------------------------------
# Google Cloud Console -> Authorized JavaScript Origins:
#   http://localhost:3000
#   https://your-app.vercel.app
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --------------------------------------------------------------------
# 5. GOOGLE GEMINI AI API (AI Travel Guardian)
# --------------------------------------------------------------------
GEMINI_API_KEY=""
DEMO_MODE="false"

# --------------------------------------------------------------------
# 6. GOOGLE MAPS PLATFORM (Places, Geocoding, Routes API)
# --------------------------------------------------------------------
# Without a key, OSM Nominatim + Overpass + OSRM fallback remains active.
GOOGLE_MAPS_API_KEY=""

# --------------------------------------------------------------------
# 7. CLOUDINARY IMAGE STORAGE (Recommended for Render Production)
# --------------------------------------------------------------------
# Render local disk storage is ephemeral across redeploys; configure Cloudinary
# so avatars and community photos persist permanently.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# --------------------------------------------------------------------
# 8. DEMO SEED ACCOUNTS (Optional)
# --------------------------------------------------------------------
ADMIN_SEED_EMAIL="admin@yatraguard.in"
ADMIN_SEED_PASSWORD="change-me-admin-password"
MODERATOR_SEED_EMAIL="moderator@yatraguard.in"
MODERATOR_SEED_PASSWORD="change-me-mod-password"
