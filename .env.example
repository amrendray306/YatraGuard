# Server Port
PORT=5001

# Database Connection (SQLite default for zero-setup local dev; or PostgreSQL for cloud production)
# SQLite: file:./dev.db
# PostgreSQL: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="file:./dev.db"

# JWT Secret for Traveler & Admin authentication tokens
JWT_SECRET="yatraguard-production-secure-jwt-secret-key-2026"

# Optional: Google Gemini API Key for Live AI Travel Guardian
# If omitted, YatraGuard operates in high-precision Contextual Safety Heuristic Mode
GEMINI_API_KEY=""

# Allowed CORS origins (comma-separated)
ALLOWED_ORIGINS="http://localhost:5001,http://localhost:5173"

# Node Environment
NODE_ENV="development"

