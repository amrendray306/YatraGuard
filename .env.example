# ====================================================================
# YATRAGUARD — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ====================================================================
# Copy this file to .env before starting the production server:
# cp .env.example .env

# --------------------------------------------------------------------
# 1. APPLICATION & SERVER RUNTIME
# --------------------------------------------------------------------
NODE_ENV="development" # Set to "production" in production environments
PORT=5001
ALLOWED_ORIGINS="http://localhost:5001,http://localhost:5173,http://localhost:3000"

# --------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (PostgreSQL / SQLite)
# --------------------------------------------------------------------
# Default: Local SQLite database for zero-friction setup and evaluation
# Production: Point to hosted PostgreSQL (e.g., Supabase, Neon, AWS RDS, Railway)
DATABASE_URL="file:./dev.db"
# Example PostgreSQL:
# DATABASE_URL="postgresql://postgres:your_secure_password@db.xyz.supabase.co:5432/postgres?schema=public"

# --------------------------------------------------------------------
# 3. CRYPTOGRAPHIC SECURITY & SESSION MANAGEMENT
# --------------------------------------------------------------------
# Generate a high-entropy 256-bit secret for signing JWT user session tokens
# e.g.: openssl rand -base64 32
JWT_SECRET="yatraguard-production-secure-jwt-secret-key-2026-btech-cse"
JWT_EXPIRY="7d"

# --------------------------------------------------------------------
# 4. GOOGLE OAUTH 2.0 / OPENID CONNECT CREDENTIALS
# --------------------------------------------------------------------
# Obtain from Google Cloud Console: https://console.cloud.google.com/apis/credentials
# Authorized Javascript Origins: http://localhost:5001, https://your-domain.com
# Authorized Redirect URIs: http://localhost:5001/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --------------------------------------------------------------------
# 5. GOOGLE GEMINI AI API (AI Travel Guardian & Safe Itinerary Planning)
# --------------------------------------------------------------------
# Obtain from Google AI Studio: https://aistudio.google.com/app/apikey
# If omitted or unconfigured, YatraGuard seamlessly operates using its
# deterministic, verified contextual safety heuristic engine (Zero Downtime).
GEMINI_API_KEY=""

# --------------------------------------------------------------------
# 6. MAPPING & GEOCODING SERVICE PROVIDER (Optional / Fallback)
# --------------------------------------------------------------------
# YatraGuard natively integrates OpenStreetMap, Nominatim, and OSRM (100% free, no key required).
# If you wish to use Google Maps Platform or Mapbox instead, configure below:
MAPS_API_KEY=""
MAPBOX_ACCESS_TOKEN=""

# --------------------------------------------------------------------
# 7. WEATHER INTELLIGENCE API (Optional / Fallback)
# --------------------------------------------------------------------
# YatraGuard natively queries Open-Meteo & IMD (zero key required).
# For OpenWeatherMap enterprise alerts, supply key below:
OPENWEATHER_API_KEY=""
